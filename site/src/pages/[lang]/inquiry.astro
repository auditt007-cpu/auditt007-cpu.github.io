---
import InquiryPage from '../../components/InquiryPage.astro';
import { LANGS, type Lang } from '../../config/site';

export function getStaticPaths() {
  return LANGS.filter((l) => l !== 'en').map((lang) => ({ params: { lang: lang as Lang } }));
}
---

<InquiryPage lang={Astro.params.lang as Lang} />
