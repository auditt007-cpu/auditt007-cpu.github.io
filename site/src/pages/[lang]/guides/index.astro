---
import GuideIndexPage from '../../../components/GuideIndexPage.astro';
import { LANGS, type Lang } from '../../../config/site';

/** Localized guide listings. English is at `/guides/` with no prefix. */
export function getStaticPaths() {
  return LANGS.filter((l) => l !== 'en').map((lang) => ({ params: { lang: lang as Lang } }));
}
---

<GuideIndexPage lang={Astro.params.lang as Lang} />
