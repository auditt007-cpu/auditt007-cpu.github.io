---
import '../styles/global.css';
import { LANGS, SITE_NAME, SITE_URL, localizedPath, type Lang } from '../config/site';
import { UI } from '../config/ui';
import { contactRows } from '../lib/contact';

export interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Absolute site-relative path of this page (leading + trailing slash). */
  path: string;
  /** hreflang alternates: [{lang, path}] for every localized version incl. this one. */
  alternates?: Array<{ lang: Lang; path: string }>;
  ogType?: 'website' | 'article';
  /** Absolute URL for og:image / twitter:image. Omitted when the article has no hero image. */
  ogImage?: string | null;
  jsonLd?: object[];
}

const {
  lang,
  title,
  description,
  path,
  alternates = [{ lang, path }],
  ogType = 'website',
  ogImage = null,
  jsonLd = [],
} = Astro.props;
const dir = lang === 'ar' ? 'rtl' : 'ltr';
const ui = UI[lang];
const canonical = `${SITE_URL}${path}`;
const xDefault = alternates.find((a) => a.lang === 'en')?.path ?? path;
const switchLangs = LANGS.map((l) => ({ lang: l, path: alternates.find((a) => a.lang === l)?.path })).filter(
  (a) => Boolean(a.path)
);
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={`${SITE_URL}${a.path}`} />)}
    <link rel="alternate" hreflang="x-default" href={`${SITE_URL}${xDefault}`} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} — guides`} href={`${SITE_URL}/rss.xml`} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : lang === 'ru' ? 'ru_RU' : 'ar_AR'} />
    {alternates.filter((a) => a.lang !== lang).map((a) => <meta property="og:locale:alternate" content={a.lang} />)}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body>
    <header class="site-head">
      <a class="brand" href={localizedPath(lang, '/')}>{SITE_NAME}</a>
      <nav class="site-nav">
        <a href={localizedPath(lang, '/guides')}>{ui.nav_guides}</a>
        <a href={localizedPath(lang, '/about')}>{ui.nav_about}</a>
        <a class="cta" href={localizedPath(lang, '/inquiry')}>{ui.nav_inquiry}</a>
      </nav>
      <nav class="lang-switch" aria-label="Language">
        {switchLangs.map(({ lang: l, path: p }) => (
          <a href={`${SITE_URL}${p!}`} hreflang={l} class:active={l === lang}>{l.toUpperCase()}</a>
        ))}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-foot">
      <div class="foot-id">
        <p>{ui.footer_note}</p>
        <p>
          © {new Date(Astro.props.date ?? Date.now()).getFullYear()} {SITE_NAME}
          {' · '}
          <a href={localizedPath(lang, '/about')}>{ui.nav_about}</a>
        </p>
      </div>
      <ul class="foot-contact">
        {contactRows(lang).map((row) => (
          <li>
            <span class="foot-label">{row.label}</span>
            {row.href
              ? (
                <a
                  href={row.href}
                  rel="noopener"
                  target={row.href.startsWith('mailto:') ? undefined : '_blank'}
                >
                  {row.value}
                </a>
              )
              : <span>{row.value}</span>}
          </li>
        ))}
      </ul>
    </footer>
  </body>
</html>
